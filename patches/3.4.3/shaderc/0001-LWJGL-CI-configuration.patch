diff --git a/.github/workflows/lwjgl.yml b/.github/workflows/lwjgl.yml
new file mode 100644
index 0000000..0763252
--- /dev/null
+++ b/.github/workflows/lwjgl.yml
@@ -0,0 +1,248 @@
+name: LWJGL Build
+
+on:
+  workflow_dispatch:
+  push:
+    branches:
+      - main
+
+env:
+  AWS_DEFAULT_REGION: us-east-1
+  AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
+  AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
+  S3_PARAMS: --cache-control "public,must-revalidate,proxy-revalidate,max-age=0"
+  CMAKE_BUILD_PARALLEL_LEVEL: 4
+  SHADERC_PARAMS: -DSHADERC_SKIP_INSTALL=ON -DSHADERC_SKIP_TESTS=ON
+
+jobs:
+  linux:
+    name: Linux
+    runs-on: ubuntu-latest
+    container:
+      image: almalinux:8
+    strategy:
+      fail-fast: false
+      matrix:
+        ARCH: [ x64 ]
+        include:
+          - ARCH: x64
+    defaults:
+      run:
+        shell: bash
+    steps:
+      - name: Install git
+        run: dnf -y install git
+      - name: Clone repository
+        run: git clone --depth 3 https://github.com/${{ github.repository }}.git .
+      - name: Install build dependencies
+        run: |
+          dnf -y install epel-release wget
+          dnf config-manager --set-enabled powertools
+          dnf -y update
+          dnf -y install gcc-toolset-15-gcc gcc-toolset-15-gcc-c++ python3 cmake awscli
+      - name: Install shaderc dependencies
+        run: python3 utils/git-sync-deps
+      - name: Configure build
+        run: |
+          source /opt/rh/gcc-toolset-15/enable || true
+          cmake -B build \
+            -DCMAKE_BUILD_TYPE=Release \
+            -DCMAKE_C_FLAGS="-U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0" \
+            $SHADERC_PARAMS
+      - name: Build
+        run: |
+          source /opt/rh/gcc-toolset-15/enable || true
+          cmake --build build
+          strip build/libshaderc/libshaderc_shared.so
+      - name: Upload artifact
+        run: aws s3 cp build/libshaderc/libshaderc_shared.so s3://lwjgl-build/nightly/linux/${{matrix.ARCH}}/libshaderc.so ${{env.S3_PARAMS}}
+      - name: Upload git revision
+        run: |
+          git config --global --add safe.directory $PWD
+          git log --first-parent --pretty=format:%H HEAD~2..HEAD~1 > libshaderc.so.git
+          aws s3 cp libshaderc.so.git s3://lwjgl-build/nightly/linux/${{matrix.ARCH}}/ ${{env.S3_PARAMS}}
+
+  linux-cross:
+    name: Linux Cross
+    runs-on: ${{matrix.RUNNER}}
+    strategy:
+      fail-fast: false
+      matrix:
+        ARCH: [arm32, arm64, ppc64le, riscv64]
+        include:
+          - ARCH: arm32
+            RUNNER: ubuntu-22.04
+            CROSS_ARCH: armhf
+            TRIPLET: arm-linux-gnueabihf
+            GCC: 12
+            CMAKE_FLAGS:
+          - ARCH: arm64
+            RUNNER: ubuntu-22.04
+            CROSS_ARCH: arm64
+            TRIPLET: aarch64-linux-gnu
+            GCC: 12
+            CMAKE_FLAGS:
+          - ARCH: ppc64le
+            RUNNER: ubuntu-22.04
+            CROSS_ARCH: ppc64el
+            TRIPLET: powerpc64le-linux-gnu
+            GCC: 12
+            CMAKE_FLAGS:
+          - ARCH: riscv64
+            RUNNER: ubuntu-24.04
+            CROSS_ARCH: riscv64
+            TRIPLET: riscv64-linux-gnu
+            GCC: 14
+            # Some weirdness with atomics
+            CMAKE_FLAGS: LDFLAGS=-pthread
+    defaults:
+      run:
+        shell: bash
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          fetch-depth: 3
+      - name: Install dependencies
+        run: |
+          DEBIAN_FRONTEND=noninteractive sudo apt-get -yq update
+          DEBIAN_FRONTEND=noninteractive sudo apt-get -yq install cmake \
+            gcc-${{matrix.GCC}}-${{matrix.TRIPLET}} \
+            g++-${{matrix.GCC}}-${{matrix.TRIPLET}} \
+            libc6-dev-${{matrix.CROSS_ARCH}}-cross
+          python3 utils/git-sync-deps
+      - name: Configure build
+        run: |
+          export PKG_CONFIG_LIBDIR="/usr/lib/${{matrix.TRIPLET}}/pkgconfig:/usr/share/pkgconfig"
+          CC=${{matrix.TRIPLET}}-gcc-${{matrix.GCC}} CXX=${{matrix.TRIPLET}}-g++-${{matrix.GCC}} ${{matrix.CMAKE_FLAGS}} cmake -B build \
+            -DCMAKE_BUILD_TYPE=Release \
+            -DCMAKE_C_FLAGS="-U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0" \
+            $SHADERC_PARAMS
+      - name: Build
+        run: |
+          cmake --build build
+          ${{matrix.TRIPLET}}-strip build/libshaderc/libshaderc_shared.so
+      - name: Upload artifact
+        run: aws s3 cp build/libshaderc/libshaderc_shared.so s3://lwjgl-build/nightly/linux/${{matrix.ARCH}}/libshaderc.so ${{env.S3_PARAMS}}
+      - name: Upload git revision
+        run: |
+          git config --global --add safe.directory $(pwd)
+          git log --first-parent --pretty=format:%H HEAD~2..HEAD~1 > libshaderc.so.git
+          aws s3 cp libshaderc.so.git s3://lwjgl-build/nightly/linux/${{matrix.ARCH}}/ ${{env.S3_PARAMS}}
+
+  freebsd-cross:
+    name: FreeBSD Cross
+    runs-on: ubuntu-latest
+    strategy:
+      fail-fast: false
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          fetch-depth: 3
+      - name: Start VM
+        uses: cross-platform-actions/action@v1.3.0
+        with:
+          operating_system: freebsd
+          architecture: x86-64
+          version: '14.4'
+          memory: 4G
+          environment_variables: SHADERC_PARAMS
+      - name: Install build dependencies
+        shell: cpa.sh {0}
+        run: |
+          sudo pkg install -y git cmake gmake python3
+          python3 utils/git-sync-deps
+      - name: Configure build
+        shell: cpa.sh {0}
+        run: cmake -B build $SHADERC_PARAMS -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_FLAGS="-U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0"
+      - name: Build
+        shell: cpa.sh {0}
+        run: |
+          cmake --build build
+          strip build/libshaderc/libshaderc_shared.so
+      - name: Upload artifact
+        run: aws s3 cp build/libshaderc/libshaderc_shared.so s3://lwjgl-build/nightly/freebsd/x64/libshaderc.so ${{env.S3_PARAMS}}
+      - name: Upload git revision
+        run: |
+          git config --global --add safe.directory $PWD
+          git log --first-parent --pretty=format:%H HEAD~2..HEAD~1 > libshaderc.so.git
+          aws s3 cp libshaderc.so.git s3://lwjgl-build/nightly/freebsd/x64/ ${{env.S3_PARAMS}}
+
+  macos:
+    name: macOS
+    runs-on: macos-latest
+    strategy:
+      fail-fast: false
+      matrix:
+        ARCH: [x64, arm64]
+        include:
+          - ARCH: x64
+            CMAKE_PARAMS: -DCMAKE_OSX_DEPLOYMENT_TARGET=10.15 -DCMAKE_OSX_ARCHITECTURES=x86_64
+          - ARCH: arm64
+            CMAKE_PARAMS: -DCMAKE_OSX_DEPLOYMENT_TARGET=11.0 -DCMAKE_OSX_ARCHITECTURES=arm64
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          fetch-depth: 3
+      - name: Install dependencies
+        run: python3 utils/git-sync-deps
+      - name: Configure build
+        run: cmake -B build $SHADERC_PARAMS -DCMAKE_BUILD_TYPE=Release ${{matrix.CMAKE_PARAMS}}
+      - name: Build
+        run: |
+          cmake --build build
+          strip -u -r build/libshaderc/libshaderc_shared.dylib
+      - name: Upload artifact
+        run: aws s3 cp build/libshaderc/libshaderc_shared.dylib s3://lwjgl-build/nightly/macosx/${{matrix.ARCH}}/libshaderc.dylib ${{env.S3_PARAMS}}
+      - name: Upload git revision
+        run: |
+          git log --first-parent --pretty=format:%H HEAD~2..HEAD~1 > libshaderc.dylib.git
+          aws s3 cp libshaderc.dylib.git s3://lwjgl-build/nightly/macosx/${{matrix.ARCH}}/ ${{env.S3_PARAMS}}
+
+  windows:
+    name: Windows
+    runs-on: windows-2022
+    strategy:
+      fail-fast: false
+      matrix:
+        ARCH: [x86, x64, arm64]
+        include:
+          - ARCH: x86
+            PLATFORM: Win32
+            #VCTOOLS: x86.x64
+          - ARCH: x64
+            PLATFORM: x64
+            #VCTOOLS: x86.x64
+          - ARCH: arm64
+            PLATFORM: ARM64
+            #VCTOOLS: ARM64
+    defaults:
+      run:
+        shell: cmd
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          fetch-depth: 3
+      - name: Install dependencies
+        run: python utils/git-sync-deps
+#      - name: Install Visual Studio 2026 Build Tools
+#        shell: pwsh
+#        run: |
+#          choco install cmake
+#          choco install visualstudio2026buildtools --package-parameters "`
+#            --add Microsoft.VisualStudio.Workload.VCTools `
+#            --add Microsoft.VisualStudio.Component.VC.Tools.${{matrix.VCTOOLS}} `
+#            --includeRecommended `
+#            --quiet" `
+#            -y `
+#            --ignore-package-exit-codes=3010
+      - name: Configure build
+        #-T ClangCL
+        run: cmake -B build -G "Visual Studio 17 2022" -A ${{matrix.PLATFORM}} %SHADERC_PARAMS%
+      - name: Build
+        run: cmake --build build --parallel --config Release
+      - name: Upload artifact
+        run: aws s3 cp build\libshaderc\Release\shaderc_shared.dll s3://lwjgl-build/nightly/windows/${{matrix.ARCH}}/shaderc.dll ${{env.S3_PARAMS}}
+      - name: Upload git revision
+        run: |
+          git log --first-parent --pretty=format:%%H HEAD~2..HEAD~1 > shaderc.dll.git
+          aws s3 cp shaderc.dll.git s3://lwjgl-build/nightly/windows/${{matrix.ARCH}}/ ${{env.S3_PARAMS}}
diff --git a/glslc/CMakeLists.txt b/glslc/CMakeLists.txt
index 948307e..b064987 100644
--- a/glslc/CMakeLists.txt
+++ b/glslc/CMakeLists.txt
@@ -53,6 +53,12 @@ if(SHADERC_ENABLE_EXECUTABLES)
   shaderc_default_compile_options(glslc_exe)
   target_include_directories(glslc_exe PRIVATE ${CMAKE_CURRENT_BINARY_DIR}/.. ${spirv-tools_SOURCE_DIR}/include)
   set_target_properties(glslc_exe PROPERTIES OUTPUT_NAME glslc)
+  # On MSVC, exporting symbols from static deps can cause the executable to
+  # emit an import library. Give it a distinct name to avoid colliding with
+  # the static library target of the same base name.
+  if (MSVC)
+    set_target_properties(glslc_exe PROPERTIES ARCHIVE_OUTPUT_NAME glslc_exe)
+  endif()
   target_link_libraries(glslc_exe PRIVATE glslc shaderc_util shaderc)
   add_dependencies(glslc_exe build-version)
 endif(SHADERC_ENABLE_EXECUTABLES)
diff --git a/libshaderc/CMakeLists.txt b/libshaderc/CMakeLists.txt
index df9a88d..a6f7a7d 100644
--- a/libshaderc/CMakeLists.txt
+++ b/libshaderc/CMakeLists.txt
@@ -63,14 +63,67 @@ endif(SHADERC_ENABLE_INSTALL)
 
 find_package(Threads)
 set(SHADERC_LIBS
-  glslang ${CMAKE_THREAD_LIBS_INIT}
+  glslang
+  glslang-default-resource-limits
+  ${CMAKE_THREAD_LIBS_INIT}
   shaderc_util
   SPIRV # from glslang
   SPIRV-Tools
 )
+set(SHADERC_SHARED_BASE_LIBS
+  ${CMAKE_THREAD_LIBS_INIT}
+  shaderc_util
+  SPIRV
+)
+
+# Link libraries as usual (static deps folded into the shared library by the linker).
+target_link_libraries(shaderc PUBLIC ${SHADERC_LIBS})
+target_link_libraries(shaderc_shared PUBLIC ${SHADERC_SHARED_BASE_LIBS})
 
-target_link_libraries(shaderc PRIVATE ${SHADERC_LIBS})
-target_link_libraries(shaderc_shared PRIVATE ${SHADERC_LIBS})
+# Ensure dependency C APIs are exported from the monolithic shared library.
+if (TARGET glslang)
+  if (WIN32)
+    # On Windows we need explicit dllexport from the dependency sources.
+    target_compile_definitions(glslang PRIVATE GLSLANG_IS_SHARED_LIBRARY=1 GLSLANG_EXPORTING=1)
+  else()
+    # On ELF/Mach-O, marking as shared enables GLSLANG_EXPORT visibility attributes.
+    target_compile_definitions(glslang PRIVATE GLSLANG_IS_SHARED_LIBRARY=1)
+  endif()
+endif()
+if (TARGET glslang-default-resource-limits)
+  if (WIN32)
+    target_compile_definitions(glslang-default-resource-limits PRIVATE GLSLANG_IS_SHARED_LIBRARY=1 GLSLANG_EXPORTING=1)
+  else()
+    target_compile_definitions(glslang-default-resource-limits PRIVATE GLSLANG_IS_SHARED_LIBRARY=1)
+  endif()
+endif()
+if (TARGET SPIRV-Tools-static)
+  target_compile_definitions(SPIRV-Tools-static PRIVATE SPIRV_TOOLS_SHAREDLIB SPIRV_TOOLS_IMPLEMENTATION)
+elseif (TARGET SPIRV-Tools)
+  target_compile_definitions(SPIRV-Tools PRIVATE SPIRV_TOOLS_SHAREDLIB SPIRV_TOOLS_IMPLEMENTATION)
+endif()
+if (TARGET SPIRV-Tools-opt)
+  target_compile_definitions(SPIRV-Tools-opt PRIVATE SPIRV_TOOLS_SHAREDLIB SPIRV_TOOLS_IMPLEMENTATION)
+endif()
+
+# Ensure dependency C APIs are included in the shared library even if unreferenced.
+if (WIN32 AND MSVC)
+  target_link_options(shaderc_shared PRIVATE
+    "/WHOLEARCHIVE:$<TARGET_FILE:glslang>"
+    "/WHOLEARCHIVE:$<TARGET_FILE:glslang-default-resource-limits>"
+    "/WHOLEARCHIVE:$<TARGET_FILE:SPIRV-Tools>"
+    "/WHOLEARCHIVE:$<TARGET_FILE:SPIRV-Tools-opt>")
+elseif(APPLE)
+  target_link_options(shaderc_shared PRIVATE
+    "-Wl,-force_load,$<TARGET_FILE:glslang>"
+    "-Wl,-force_load,$<TARGET_FILE:glslang-default-resource-limits>"
+    "-Wl,-force_load,$<TARGET_FILE:SPIRV-Tools>"
+    "-Wl,-force_load,$<TARGET_FILE:SPIRV-Tools-opt>")
+else()
+  # GCC/Clang on ELF platforms
+  target_link_libraries(shaderc_shared PRIVATE
+    "-Wl,--whole-archive" glslang glslang-default-resource-limits SPIRV-Tools SPIRV-Tools-opt "-Wl,--no-whole-archive")
+endif()
 
 shaderc_add_tests(
   TEST_PREFIX shaderc
diff --git a/third_party/CMakeLists.txt b/third_party/CMakeLists.txt
index 9e9d8b1..fecab91 100644
--- a/third_party/CMakeLists.txt
+++ b/third_party/CMakeLists.txt
@@ -92,7 +92,11 @@ if (NOT TARGET glslang)
       # Glslang tests are off by default. Turn them on if testing Shaderc.
       set(GLSLANG_TESTS ON)
     endif()
-    set(GLSLANG_ENABLE_INSTALL $<NOT:${SKIP_GLSLANG_INSTALL}>)
+    if (SKIP_GLSLANG_INSTALL)
+      set(GLSLANG_ENABLE_INSTALL OFF)
+    else()
+      set(GLSLANG_ENABLE_INSTALL ON)
+    endif()
     set(ENABLE_HLSL "${SHADERC_ENABLE_HLSL}")
     add_subdirectory(${SHADERC_GLSLANG_DIR} glslang)
   endif()
